rules_version = '2';

// Clocktower's character library: read with its key (a shared account) or by the admin, who alone
// writes it. Saved designs live in each browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && email() == 'admin@example.invalid';
    }

    // Clocktower is private until The Pandemonium Institute says otherwise: its library is read
    // by the admin and by the shared account whose key is given to whoever may use it.
    function canSeeBotc() {
      return isAdmin() || (request.auth != null && request.auth.token.email == 'clocktower@tesserae-faber.web.app');
    }

    // The character library: names, team and icons.
    match /roles/{roleId} {
      allow read: if canSeeBotc();
      allow write: if isAdmin();
    }

    // Other library artwork, such as the seal used on token backs.
    match /library/{assetId} {
      allow read: if canSeeBotc();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
