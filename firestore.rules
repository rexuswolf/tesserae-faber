rules_version = '2';

// Midnight Mint is invite-only: the role library (which contains The Pandemonium
// Institute's character artwork) is readable only by invited, signed-in people.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && email() == 'admin@example.invalid';
    }
    function invited() {
      return isAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/allowlist/$(email())));
    }

    // One document per invited email address (the document id is the lower-case email).
    match /allowlist/{address} {
      allow read: if isAdmin() || (signedIn() && email() == address);
      allow write: if isAdmin();
    }

    // The character library: names, team and traced icon paths.
    match /roles/{roleId} {
      allow read: if invited();
      allow write: if isAdmin();
    }

    // Other library artwork, such as the seal used on token backs.
    match /library/{assetId} {
      allow read: if invited();
      allow write: if isAdmin();
    }

    // Each person's saved token designs.
    match /users/{uid}/designs/{designId} {
      allow read, delete: if invited() && request.auth.uid == uid;
      allow create, update: if invited() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['roleId', 'text', 'spec', 'title', 'updatedAt'])
        && request.resource.data.roleId is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.spec is map
        && (!('customSvg' in request.resource.data.spec)
            || request.resource.data.spec.customSvg == null
            || request.resource.data.spec.customSvg.size() <= 300000);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
