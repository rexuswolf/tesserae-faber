rules_version = '2';

// Clocktower's character library: read by anyone, written by the admin alone. Saved designs live in each browser.
service cloud.firestore {
  match /databases/{database}/documents {

    // the admin, by its account id (src/services.ts ADMIN_UID)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ZF6TRxFCPNh6Bjvg7rbv5mAD0x83';
    }

    // Clocktower is public. To make it private again (read only by the admin and the shared account
    // whose key is given out), return:
    //   isAdmin() || (request.auth != null && request.auth.token.email == 'clocktower@tesserae-faber.web.app')
    // and set BOTC_PUBLIC = false in src/services.ts.
    function canSeeBotc() {
      return true;
    }

    // The character library: names, team and icons.
    match /roles/{roleId} {
      allow read: if canSeeBotc();
      allow write: if isAdmin();
    }

    // Other library artwork, such as the seal used on token backs.
    match /library/{assetId} {
      allow read: if canSeeBotc();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
