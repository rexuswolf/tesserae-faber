rules_version = '2';

// Midnight Mint needs no sign-in: anyone can read the character library.
// Only the admin account can write to it. Saved designs live in each browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && email() == 'admin@example.invalid';
    }

    // The character library: names, team and traced icon paths.
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Other library artwork, such as the seal used on token backs.
    match /library/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Designs saved to accounts before the app went sign-in free: their owner can
    // still read and delete them (the app moves them into the browser), never add more.
    match /users/{uid}/designs/{designId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
