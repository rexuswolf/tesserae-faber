    "@playwright/test": "^1.65.0",
    "@types/three": "~0.160.0",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.34.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
